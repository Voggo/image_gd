{
  "input_path": "data/images_2",
  "recursive": true,
  "compare_png": true,
  "csv_profile_groups": [
    {
      "name": "csv_compression",
      "float_storage": ["f32"],
      "has_headers": [true],
      "select_impl": ["optimized"],
      "base_bit_impl": ["batch_groups", "signature_groups"],
      "entropy_impl": ["naive"],
      "entropy_skip_rows": { "values": [0] },
      "use_condensed_samples": [true],
      "base_table_impl": ["raw"],
      "delta_codec_impl": ["none"],
      "encode_impl": ["optimized", "rle"],
      "m_max": { "range": { "start": 0, "end": 60, "step": 30 } },
      "patience": { "values": [10] },
      "entropy_threshold": [0.7],
      "preprocess": {
        "float_scaling": ["scaled_offset_signed_int"],
        "max_decimal_scale": { "values": [9] },
        "integer_zero_normalization": [true]
      }
    }
  ],
  "image_profile_groups": [
    {
      "name": "img_compression",
      "build": {
        "colorspace": ["srgb_with_linear_alpha"],
        "color_model": ["rgb"],
        "pixel_grouping": [{"width": 1, "height": 1 }, {"width": 2, "height": 2 }, { "width": 3, "height": 3 }, { "width": 4, "height": 4 }],
        "grouping_transform": ["raw"]
      },
      "m_max": { "values": [0] },
      "patience": { "values": [15] },
      "entropy_threshold": [0.7],
      "select_impl": ["naive"],
      "base_bit_impl": ["naive"],
      "entropy_impl": ["naive"],
      "entropy_skip_rows": { "values": [0] },
      "use_condensed_samples": [false],
      "base_table_impl": ["raw"],
      "delta_codec_impl": ["none"],
      "encode_impl": ["huffman_base_id_only"]
    }
  ]
}
